# Pick ONE provider. With nothing set, DocFlow runs the offline rules baseline.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DOCFLOW_PROVIDER=ollama          # free local model, run `ollama pull llama3.1:8b` first
# DOCFLOW_MODEL=claude-haiku-4-5   # override the default model for the chosen provider
# DOCFLOW_DB=docflow.db
